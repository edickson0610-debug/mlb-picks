{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-2.5-pro",
  "instructions": ["AGENTS.md"],
  "provider": {
    "google": {
      "options": {
        "apiKey": "${env:GEMINI_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": { "python *": "allow", "pip *": "allow" }
  }
}